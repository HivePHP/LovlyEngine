# Application
APP_NAME=LovlyEngine
APP_ENV=local
APP_DEBUG=true

# Database
DB_HOST=MariaDB-11.8
DB_DATABASE=hivephp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Cookie
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax

# View
VIEW_CACHE=storage/cache/view
VIEW_AUTO_RELOAD=true
VIEW_DEBUG=true
VIEW_STRICT_VARIABLES=true

# Realtime (Socket.IO / notifications)
REALTIME_ENABLED=true
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
REALTIME_PATH=/socket.io
# REALTIME_PUBLIC_URL=http://127.0.0.1:3001
REALTIME_SECRET=change-me-put-a-long-random-string-here
REALTIME_TOKEN_TTL=300
REALTIME_HTTP_TIMEOUT=2000
NOTIFICATION_MAX_ITEMS=30
NOTIFICATION_TTL_DAYS=90