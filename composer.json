{
    "name": "oldvkdev/hivephp",
    "description": "HivePHP micro-framework project",
    "type": "project",
    "require": {
        "php": "^8.2",
        "twig/twig": "^3.0",
        "symfony/contracts": "^2.5|^3",
        "symfony/polyfill-ctype": "^1.18",
        "symfony/polyfill-mbstring": "^1.18",
        "symfony/deprecation-contracts": "^2.5|^3",
      "ext-pdo": "*",
        "gregwar/captcha": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "HivePHP\\": "core/"
        },
        "files": [
            "core/Support/helpers.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"@mkdir('storage/logs', 0777, true); @mkdir('storage/cache/view', 0777, true);\""
        ],
        "post-update-cmd": [
            "php -r \"@mkdir('storage/logs', 0777, true); @mkdir('storage/cache/view', 0777, true);\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.30"
        }
    }
}
