{% extends "layouts/main.twig" %}

{% block content %}
<div class="albums-main" data-album-page data-album-id="{{ album.id }}" data-is-owner="{{ is_owner ? '1' : '0' }}" data-protected="{{ album.is_protected ? '1' : '0' }}">

    <div class="profile-card albums-card album-page-card">
        <div class="albums-header">
            <div class="albums-header-left">
                <a class="album-back-link" href="/albums/id{{ user_id }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                    <span>Все альбомы</span>
                </a>
                <h2 class="albums-title">
                    {{ album.title }}
                    {% if album.is_protected %}<span class="album-badge">системный</span>{% endif %}
                </h2>
                {% if album.description %}
                    <div class="album-page-description">{{ album.description }}</div>
                {% endif %}
            </div>
            {% if is_owner and photos is not empty and not album.is_protected %}
                <button type="button" class="btn-primary album-header-upload" data-upload-trigger>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12"/><path d="M6 10l6-6 6 6"/><path d="M4 20h16"/></svg>
                    Загрузить фотографии
                </button>
            {% endif %}
        </div>

        {% if is_owner and not album.is_protected %}
        <input type="file" id="album-photo-input" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>
        {% endif %}
        <div class="album-photos-wrap">
            <div class="album-upload-error" data-upload-error></div>
            <div data-upload-progress></div>

            {% if photos is empty %}
                {% if album.is_protected %}
                    <div class="upload-area">
                        <div class="upload-icon">
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/><path d="M4 17l5-5 3 3 2-2 6 6"/></svg>
                        </div>
                        <div class="upload-title">Здесь сохраняются оригиналы ваших фотографий профиля</div>
                        <div class="upload-subtitle">Фотографии добавляются сюда автоматически при смене аватарки.</div>
                    </div>
                {% else %}
                    <div class="upload-area{% if is_owner %} upload-area--interactive{% endif %}" data-upload-area>
                        <div class="upload-icon">
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/><path d="M4 17l5-5 3 3 2-2 6 6"/></svg>
                        </div>
                        <div class="upload-title">В этом альбоме пока нет фотографий</div>
                        {% if is_owner %}
                        <div class="upload-subtitle">Выберите несколько фотографий или перетащите их сюда</div>
                        <button type="button" class="btn-primary upload-button" data-upload-trigger>Загрузить фотографии</button>
                        {% endif %}
                    </div>
                {% endif %}
            {% else %}
                <div class="photos-grid" data-photos-grid>
                    {% for photo in photos %}
                        <div class="photo{% if is_owner and not album.is_protected %} photo--owner photo--draggable{% elseif is_owner %} photo--owner{% endif %}" data-photo-id="{{ photo.id }}" draggable="false">
                            <img class="photo-open" src="{{ photo.path }}" data-photo-full="{{ photo.path }}" alt="" loading="lazy">
                            {% if is_owner %}
                                <button type="button" class="photo-delete" data-delete-photo title="Удалить">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="albums-lightbox" data-lightbox hidden>
            <button type="button" class="albums-lightbox-close" data-lightbox-close aria-label="Закрыть">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <img src="" alt="" data-lightbox-image>
        </div>

        {% if is_owner %}
        <div class="album-modal modal" data-confirm-modal data-modal hidden>
            <div class="album-modal-backdrop modal-backdrop" data-modal-backdrop data-modal-close></div>
            <div class="album-modal-card modal-card">
                <h3 class="album-modal-title modal-title">Удаление фотографии</h3>
                <div class="modal-body">
                    <p class="album-confirm-text" data-confirm-text>{% if album.is_protected %}Вы действительно хотите удалить эту фотографию? Если это текущая фотография профиля, аватар сбросится на предыдущий (или на заглушку), если такой нет.{% else %}Вы действительно хотите удалить фотографию?{% endif %}</p>
                </div>
                <div class="album-modal-error modal-error" data-modal-error></div>
                <div class="album-modal-actions modal-actions">
                    <button type="button" class="btn-primary album-danger-btn" data-confirm-yes>Да</button>
                    <button type="button" class="btn-secondary" data-modal-close>Нет</button>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

</div>
{% endblock %}
