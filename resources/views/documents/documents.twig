{% extends "layouts/main.twig" %}

{% block content %}
<div class="docs-main" data-docs-page data-viewer-id="{{ viewer_id }}" data-owner-id="{{ owner_id }}" data-is-public="{{ is_public ? '1' : '0' }}">

    <div class="profile-card">
        <div class="docs-header">
            {% if is_public %}
                <h2 class="docs-title">Документы — {{ owner_name }}</h2>
                <a href="/id{{ owner_id }}" class="btn-secondary docs-profile-link">В профиль</a>
            {% else %}
                <h2 class="docs-title">Мои документы</h2>
                <button type="button" class="btn-primary docs-upload-btn" data-upload-trigger>Загрузить файл</button>
            {% endif %}
        </div>

        {% if not is_public %}
        <div data-upload-progress></div>
        {% endif %}

        <div class="docs-content" data-docs-content>
            {% if documents is empty %}
                <div class="docs-empty">
                    <div class="docs-empty-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#b0b8c1" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    {% if is_public %}
                        <p class="docs-empty-title">У пользователя пока нет документов</p>
                    {% else %}
                        <p class="docs-empty-title">У вас пока нет документов</p>
                        <p class="docs-empty-text">Загрузите документы и храните их в одном месте.</p>
                        <button type="button" class="btn-primary" data-upload-trigger>Загрузить файлы</button>
                    {% endif %}
                </div>
            {% else %}
                {% if not is_public %}
                <div class="docs-dropzone" data-dropzone>
                    <div class="docs-dropzone-inner">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 15V4"/><path d="m8 8 4-4 4 4"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
                        <span>Перетащите файлы сюда</span>
                    </div>
                </div>
                {% endif %}
                <div class="docs-list" data-docs-list>
                    {% for doc in documents %}
                        <div class="doc" data-doc-id="{{ doc.id }}" data-doc-name="{{ doc.name }}" data-doc-path="{{ doc.path }}" data-doc-type="{{ doc.type }}">
                            <div class="doc-icon" data-doc-icon="{{ doc.name }}">
                                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h8l4 4v14H6V3Z"/><path d="M14 3v5h4"/><path d="M9 12h6"/><path d="M9 16h6"/></svg>
                            </div>
                            <div class="doc-info">
                                <div class="doc-name" title="{{ doc.name }}">{{ doc.name }}</div>
                                <div class="doc-meta">
                                    <span class="doc-ext">{{ doc.name|split('.')|last|upper }}</span>
                                    <span class="doc-sep">&middot;</span>
                                    <span>{{ doc.size > 1048576 ? (doc.size / 1048576)|round(1) ~ ' МБ' : (doc.size / 1024)|round(1) ~ ' КБ' }}</span>
                                    <span class="doc-sep">&middot;</span>
                                    <span>{{ doc.created_at|date('d.m.Y') }}</span>
                                </div>
                            </div>
                            <div class="doc-actions">
                                <button type="button" class="doc-action doc-action--preview" data-doc-preview title="Просмотр">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                                <a href="/api/documents/{{ doc.id }}/download" class="doc-action" title="Скачать">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V4"/><path d="m8 8 4-4 4 4"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
                                </a>
                                {% if not is_public %}
                                <button type="button" class="doc-action doc-action--delete" data-doc-delete title="Удалить">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {% if not is_public %}
    <input type="file" id="docs-file-input" multiple hidden>
    {% endif %}

    <!-- PREVIEW MODAL -->
    <div class="preview-modal" data-preview-modal hidden>
        <div class="preview-modal-backdrop" data-preview-close></div>
        <div class="preview-modal-card">
            <div class="preview-modal-header">
                <span class="preview-modal-title" data-preview-title></span>
                <div class="preview-modal-actions">
                    <a href="#" class="preview-modal-download" data-preview-download title="Скачать">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V4"/><path d="m8 8 4-4 4 4"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
                    </a>
                    <button type="button" class="preview-modal-close" data-preview-close>&times;</button>
                </div>
            </div>
            <div class="preview-modal-body" data-preview-body></div>
        </div>
    </div>

</div>
{% endblock %}
