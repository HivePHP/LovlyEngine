{% extends "layouts/main.twig" %}

{% block content %}
<div class="notif-main" data-notif-page data-viewer-id="{{ viewer_id }}">

    <div class="profile-card">
        <div class="notif-header">
            <h2 class="notif-title">Уведомления</h2>
            <div class="notif-actions">
                {% if notifications %}
                    <button type="button" class="notif-action-btn" data-notif-markall>Прочитать все</button>
                    <button type="button" class="notif-action-btn notif-action-btn--danger" data-notif-deleteall>Удалить все</button>
                {% endif %}
            </div>
        </div>

        <div class="notif-list" data-notif-list>
            {% for n in notifications %}
                <div class="notif-item{% if not n.is_read %} is-unread{% endif %}" data-notif-item data-notif-id="{{ n.id }}">
                    <div class="notif-item-avatar">
                        {% if n.actor_avatar %}
                            <img src="{{ n.actor_avatar }}" alt="" loading="lazy">
                        {% else %}
                            <span class="notif-item-initials">{{ (n.actor_name|slice(0,1) ~ n.actor_surname|slice(0,1))|upper }}</span>
                        {% endif %}
                    </div>
                    <div class="notif-item-body">
                        <div class="notif-item-text">
                            <span class="notif-item-actor">{{ n.actor_name }} {{ n.actor_surname }}</span>
                            {% if n.type == 'friend.request' %}
                                отправил(а) вам заявку в друзья
                            {% elseif n.type == 'friend.accepted' %}
                                принял(а) вашу заявку в друзья
                            {% else %}
                                {{ n.type }}
                            {% endif %}
                        </div>
                        <div class="notif-item-time">{{ n.created_at }}</div>
                    </div>
                    <div class="notif-item-actions">
                        {% if not n.is_read %}
                            <button type="button" class="notif-item-btn notif-item-btn--read" data-notif-action="read">Прочитано</button>
                        {% endif %}
                        <button type="button" class="notif-item-btn notif-item-btn--delete" data-notif-action="delete">Удалить</button>
                    </div>
                </div>
            {% else %}
                <div class="notif-empty">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#b0b8c1" stroke-width="1.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <p>Уведомлений пока нет</p>
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}
